      type: 0
      typeString: 
    - title: Pictures
      value: '[]'
      type: 3
      typeString: CustomFieldType_Files
    - title: Description
      value: "Higura, a battle-worn drunkard with a penchant for sarcasm, has challenged
        you to retrieve a precious gem from a chest in the treacherous Hall of Spikes.
        Master the art of dodging by rolling with precision to avoid the deadly traps
        scattered across the room. Prove your mettle or end up as another unfortunate
        addition to the dungeon\u2019s d\xE9cor"
      type: 0
      typeString: 
