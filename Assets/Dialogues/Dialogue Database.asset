      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "This place... it\u2019s nothing like the rest of the dungeon. It
          feels alive."
        type: 0
        typeString: 
      - title: Sequence
        value: 
