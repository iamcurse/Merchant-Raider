        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Aye, it does. The light above breathes life into this garden, though
          its roots are nourished by the blood spilled in these very halls. Beauty
          and cruelty, forever entwined. But you didn\u2019t come here to admire
          the flowers, did you?"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 10
      isRoot: 0
      isGroup: 0
